# Bluetooth stack tarball and the font files, each pinned by URL and checksum.
deploy/

# What build.sh stages into the install tree: the two binaries, the Bluetooth
# stack and the writing faces. config.ini is the one hand-written file in hid/.
device/extensions/karyll/bin/karyll
device/extensions/karyll/bin/karyll-softfloat
device/extensions/karyll/fonts/
device/extensions/karyll/var/
device/extensions/karyll/hid/*
!device/extensions/karyll/hid/config.ini

